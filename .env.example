# SAVY TRAVEL SERVICES — environment variables
# Copy to .env.local for development. In production, set these in your host
# (e.g. Vercel → Project → Settings → Environment Variables). Never commit real secrets.

# --- Site -----------------------------------------------------------------
# Public base URL (used for canonical URLs, sitemap, e-mail links, payment returns)
NEXT_PUBLIC_SITE_URL=https://savytravelservices.tn

# --- Supabase (required) ----------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Public client key: the "publishable" key (sb_publishable_…) or the legacy anon key.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...   (alternative to the publishable key)
# SERVER ONLY — secret/service-role key. Required for payment verification
# (webhooks / return page). Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- E-mail notifications (optional, https://resend.com) --------------------
RESEND_API_KEY=
# Verified sender, e.g. "SAVY Travel Services <noreply@savytravelservices.tn>"
EMAIL_FROM=
# Inbox that receives "new booking / visa / contact" alerts
AGENCY_NOTIFICATION_EMAIL=contact@savytravelservices.tn

# --- Flights: Amadeus Self-Service (optional) --------------------------------
# Without these, the flights page sends requests to advisors (no fake results).
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
# "test" (default) or "production"
AMADEUS_ENV=test
AMADEUS_CURRENCY=TND

# --- Payments (optional; online payment links disabled until set) ----------
# Konnect — https://konnect.network
KONNECT_API_KEY=
KONNECT_WALLET_ID=
# "production" or anything else for the pre-production sandbox
KONNECT_ENV=sandbox
# KONNECT_API_BASE=https://api.konnect.network/api/v2
# Flouci — https://flouci.com
FLOUCI_APP_TOKEN=
FLOUCI_APP_SECRET=
# FLOUCI_API_BASE=https://developers.flouci.com/api

# --- Exchange rates (optional) ------------------------------------------------
# JSON endpoint returning { rates: { EUR: <per 1 TND>, USD: <per 1 TND> } }.
# Default: https://open.er-api.com/v6/latest/TND (free, attribution: ExchangeRate-API)
# EXCHANGE_RATE_API_URL=
